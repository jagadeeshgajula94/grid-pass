{
  "name": "grid-pass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "overrides": {
    "postcss": "^8.5.23",
    "@eslint/eslintrc": {
      "minimatch": "3.1.5"
    },
    "eslint": {
      "minimatch": "3.1.5"
    },
    "@eslint/config-array": {
      "minimatch": "3.1.5"
    },
    "eslint-plugin-sonarjs": {
      "minimatch": "^11.0.1"
    }
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "!(next-env.d).{js,mjs,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --check"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "4.1.12",
    "vite": "^7.3.8"
  }
}
