# Optional: Next.js selects development/test/production automatically.
# NODE_ENV=development
# Public, non-secret application origin. Defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Required server-only signing key. Generate with: openssl rand -base64 48
AUTH_SECRET=
# Optional development-only dummy-user password (at least 12 characters).
MOCK_USER_PASSWORD=
